POSTGRES_DB=autoleads
POSTGRES_USER=autoleads
POSTGRES_PASSWORD=autoleads_pass
DATABASE_URL=Host=db;Port=5432;Database=autoleads;Username=autoleads;Password=autoleads_pass

# API Key server-to-server. Requerida en /api/* (el frontend la manda en X-Api-Key).
# Generala con: openssl rand -hex 32
# Si queda vacía, en Development la API no valida; en Production rechaza con 503.
API_KEY=

# Orígenes permitidos para CORS, separados por coma (sin espacios extra).
# En producción poné el dominio real de Cloudflare Pages, ej:
# ALLOWED_ORIGINS=https://autoleads-crm.pages.dev
# Si queda vacía, se usa el fallback de desarrollo (localhost:5173, localhost:3000, 127.0.0.1:5173).
ALLOWED_ORIGINS=
