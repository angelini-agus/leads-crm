POSTGRES_DB=autoleads
POSTGRES_USER=autoleads
POSTGRES_PASSWORD=autoleads_pass
DATABASE_URL=Host=db;Port=5432;Database=autoleads;Username=autoleads;Password=autoleads_pass

# Entorno de la API.
#   Development -> local: usa orígenes CORS de desarrollo.
#   Production  -> deploy: obliga ALLOWED_ORIGINS (si falta, falla).
# El compose usa Production como fallback si esta variable no está seteada.
ASPNETCORE_ENVIRONMENT=Development

# Clave de firma de los JWT. OBLIGATORIA en cualquier entorno (si falta, la API
# no arranca). Generala con: openssl rand -hex 32
JWT_SECRET=

# Orígenes permitidos para CORS, separados por coma (sin espacios extra).
# En Development puede quedar vacía: usa localhost:5173, localhost:3000, 127.0.0.1:5173.
# En Production es obligatoria (si falta, la API no arranca). Ej:
# ALLOWED_ORIGINS=https://autoleads-crm.pages.dev
ALLOWED_ORIGINS=

# Bootstrap del primer administrador. Si la tabla `usuarios` no tiene ningún
# admin activo, la API crea uno al arrancar. Si SEED_ADMIN_PASSWORD queda
# vacía, genera una contraseña temporal aleatoria y la escribe en el log
# (revisala con: docker compose logs api). No commitees una contraseña real.
SEED_ADMIN_EMAIL=admin@autoleads.com
SEED_ADMIN_PASSWORD=
