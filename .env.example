POSTGRES_DB=autoleads
POSTGRES_USER=autoleads
POSTGRES_PASSWORD=autoleads_pass
DATABASE_URL=Host=db;Port=5432;Database=autoleads;Username=autoleads;Password=autoleads_pass

# Entorno de la API.
#   Development -> local: no exige API_KEY y usa orígenes CORS de desarrollo.
#   Production  -> deploy: obliga API_KEY y ALLOWED_ORIGINS (si faltan, falla).
# El compose usa Production como fallback si esta variable no está seteada.
ASPNETCORE_ENVIRONMENT=Development

# API Key server-to-server. El frontend la manda en el header X-Api-Key.
# Generala con: openssl rand -hex 32
# En Development puede quedar vacía (la API no valida).
# En Production es obligatoria: si falta, la API responde 503 en /api/*.
API_KEY=

# Orígenes permitidos para CORS, separados por coma (sin espacios extra).
# En Development puede quedar vacía: usa localhost:5173, localhost:3000, 127.0.0.1:5173.
# En Production es obligatoria (si falta, la API no arranca). Ej:
# ALLOWED_ORIGINS=https://autoleads-crm.pages.dev
ALLOWED_ORIGINS=
