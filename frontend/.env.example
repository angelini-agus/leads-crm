# Copia este archivo a .env.local y ajustá los valores
# Este archivo se incluye en git — no pongas secretos aquí

# URL base de la API (sin trailing slash)
# En desarrollo: vacío (Vite usa el proxy definido en vite.config.js)
# En producción: URL pública de tu VPS/backend
VITE_API_URL=

# API Key que se envía en el header X-Api-Key en cada request.
# Debe coincidir con el API_KEY del backend.
# En desarrollo puede quedar vacía si el backend corre en Development (no valida).
# En producción es obligatoria y debe coincidir con API_KEY.
# OJO: al compilarse dentro del bundle, es visible para cualquier visitante.
VITE_API_KEY=
